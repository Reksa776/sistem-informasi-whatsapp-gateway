# ===== Server =====
NODE_ENV=development
PORT=5000

# ===== Database =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_whatsapp
DB_DIALECT=mysql

# ===== Auth / JWT =====
# Wajib diisi. Gunakan string acak yang panjang.
JWT_SECRET=ubah-dengan-secret-acak-panjang
JWT_EXPIRES_IN=1d

# ===== Cookie =====
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000

# ===== CORS =====
# Bisa satu origin, banyak origin dipisah koma, atau * untuk semua origin.
CORS_ORIGIN=*

# ===== WhatsApp =====
# Path relatif dihitung dari folder backend/. Gunakan path absolut jika perlu.
WHATSAPP_SESSION_DIR=./sessions

# ===== Upload =====
UPLOAD_DIR=./uploads
TMP_UPLOAD_DIR=/tmp
